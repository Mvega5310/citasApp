# ── Datos ──
# firestore (por defecto) | postgres
DATA_BACKEND=postgres
# En Railway: ${{Postgres.DATABASE_URL}}. En local: la URL pública de Postgres (o RAILWAY_DATABASE_URL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Aplicación ──
NEXT_PUBLIC_APP_NAME=Marcos BarberShop
# Dirección pública de la barbería por defecto (enlaces de correos y recordatorios)
APP_URL=https://citas.proyects.store
# Dominio base: cada barbería nueva vive en {barbería}.<este dominio>
NEXT_PUBLIC_APP_DOMAIN=citas.proyects.store
NEXT_PUBLIC_DEFAULT_TENANT=demo
APP_ENV=production
LOG_LEVEL=info
# Firma de la sesión del panel (texto aleatorio largo)
ADMIN_SECRET=cambia_esto_por_un_texto_aleatorio_largo
# Clave que la tarea de recordatorios envía a /api/cron/reminder
CRON_SECRET=cambia_esto_por_otro_texto_aleatorio

# ── Correo ──
# Resend (recomendado; en Railway Hobby el SMTP está bloqueado)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Marcos BarberShop <citas@proyects.store>
# Correo que recibe los avisos de la barbería por defecto
EMAIL_TO_DEFAULT=marcosbarbershop89@gmail.com
# SMTP (alternativa a Resend; solo si el hosting permite SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password

# ── Firebase (solo con DATA_BACKEND=firestore o para copiar datos a Postgres) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_service_account_json
# o los campos por separado en vez de FIREBASE_SERVICE_ACCOUNT_BASE64
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"

# ── Twilio (opcional, WhatsApp) ──
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
